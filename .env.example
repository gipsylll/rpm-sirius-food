SECRET_KEY=your-super-secret-key-change-in-production
DATABASE_URL=postgresql://sirius:sirius@localhost:5432/sirius_food
REDIS_URL=redis://localhost:6379/0
DEBUG=False
ALLOWED_ORIGINS=["https://sirius-food.ru"]
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Опционально для лабораторной № 9
# Для локального self-hosted Sentry замените localhost в выданном DSN
# на host.docker.internal:9000: API работает внутри Docker.
SENTRY_DSN=
SENTRY_TEST_ENABLED=0
